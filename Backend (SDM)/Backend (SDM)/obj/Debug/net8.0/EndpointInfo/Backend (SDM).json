  "components": {
    "schemas": {
      "AddRegisterMemberRequest": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "integer",
            "format": "int32"
          },
          "remarks": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Gender": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "MemberViewModel": {
        "required": [
          "dateOfBirth",
          "firstName",
          "gender",
          "lastName",
          "membershipNumber",
          "societyId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "membershipNumber": {
            "minLength": 1,
            "type": "string"
          },
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "mobileNumber": {
            "type": "string",
            "nullable": true
          },
          "physicalAddress": {
            "type": "string",
            "nullable": true
          },
          "societyId": {
            "type": "integer",
            "format": "int32"
          },
          "societyName": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "RegisterMemberCategoryViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "statisticalCategoryId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryCode": {
            "type": "string",
            "nullable": true
          },
          "categoryName": {
            "type": "string",
            "nullable": true
          },
          "selected": {
            "type": "boolean"
          },
          "valueNumber": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "valueText": {
            "type": "string",
            "nullable": true
          },
          "isSystemGenerated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "RegisterStatus": {
        "enum": [
          1,
          2,
          3,
          4,
          5
        ],
        "type": "integer",
        "format": "int32"
      },
      "StatisticalRegisterViewModel": {
        "required": [
          "circuitId",
          "compiledByUserId",
          "districtId",
          "societyId",
          "statisticalYearId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "statisticalYearId": {
            "type": "integer",
            "format": "int32"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "districtId": {
            "type": "integer",
            "format": "int32"
          },
          "districtName": {
            "type": "string",
            "nullable": true
          },
          "circuitId": {
            "type": "integer",
            "format": "int32"
          },
          "circuitName": {
            "type": "string",
            "nullable": true
          },
          "societyId": {
            "type": "integer",
            "format": "int32"
          },
          "societyName": {
            "type": "string",
            "nullable": true
          },
          "compiledByUserId": {
            "type": "integer",
            "format": "int32"
          },
          "compiledByUserName": {
            "type": "string",
            "nullable": true
          },
          "dateCompiled": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/RegisterStatus"
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
